        ".pg{page-break-inside:avoid;margin-bottom:16px}.no{color:#E30613;font-family:monospace}" +
        ".s{margin:4px 0 4px 12px}.s span{color:#555;display:block;font-size:11.5px}" +
        ".nt{background:#f5f5f5;border-left:3px solid #E30613;padding:7px 9px;margin-top:6px;font-size:11.5px;line-height:1.7;white-space:pre-wrap}" +
        ".pb{position:fixed;top:0;left:0;right:0;background:#1A1A1A;color:#fff;padding:9px 16px}" +
        ".pb button{padding:7px 18px;border:none;border-radius:5px;background:#E30613;color:#fff;font-size:14px;font-weight:700;cursor:pointer}" +
        "@media print{.pb,.sp{display:none}}</style>" +
        "<div class=\"pb\"><button onclick=\"window.print()\">🖨 列印 / 存成 PDF</button></div><div class=\"sp\" style=\"height:44px\"></div>';" +
        "a.forEach(function(s){h+='<div class=\"pg\"><h2><span class=\"no\">'+(s.no<10?'0':'')+s.no+'</span>　'+s.title+'</h2>';" +
        "s.steps.forEach(function(c,i){h+='<div class=\"s\"><b>'+(i+1)+'. '+c.h+'</b>'+(c.p?'<span>'+c.p+'</span>':'')+'</div>'});" +
        "if(s.note)h+='<div class=\"nt\">'+s.note+'</div>';h+='</div>'});" +
        "var w=window.open('','_blank');w.document.open();w.document.write(h);w.document.close()}" +
      "document.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();go('next')}" +
        "else if(e.key==='ArrowLeft'){e.preventDefault();go('prev')}});" +
      "setInterval(draw,180);setInterval(tick,1000);draw();tick();";

    return '<!DOCTYPE html><html lang="zh-TW"><head><meta charset="UTF-8"><title>簡報者視窗</title>' +
      '<style>' + css + '</style></head><body>' +
      '<div class="hd"><span class="r" id="rt">//</span><span class="pg" id="pg">— / —</span>' +
      '<button onclick="printAll()">🖨 印出全部講稿</button>' +
      '<button onclick="resetT()">計時歸零</button><button onclick="toggleT()">開始 / 暫停</button>' +
      '<span class="tm" id="tm">00:00</span></div>' +
      '<div class="bd" id="bd"><div class="col" id="L"></div><div class="col" id="R"></div></div>' +
      '<div class="ft"><button onclick="go(\'prev\')">‹ 上一步</button>' +
      '<button class="go" onclick="go(\'next\')">下一步 ›</button></div>' +
      '<script>' + js + '<\/script></body></html>';
  }

  /* ── 手機瀑布流 ── */
  function enterFlow(){
    FLOW = true;
    document.body.classList.add('flow');
    $('deck').style.transform = '';
    slides().forEach(function(el){
      el.classList.add('on', 'play');
      stepsOf(el).forEach(function(x){ x.classList.add('shown'); });
    });
    var fp = $('flowprog'), tt = $('totop');
    function onScroll(){
      var h = document.documentElement.scrollHeight - innerHeight;
      fp.style.width = (h > 0 ? scrollY / h * 100 : 0) + '%';
      tt.classList.toggle('on', scrollY > innerHeight * .8);
    }
    addEventListener('scroll', onScroll, {passive:true});
    tt.onclick = function(){ scrollTo({ top:0, behavior:'smooth' }); };
    onScroll();
  }

  /* ── 啟動 ── */
  build();
  buildGrid();

  if (isFlow()){ enterFlow(); }
  else {
    fit(); show(0, false);
    addEventListener('resize', function(){
      if (isFlow() && !FLOW){ location.reload(); return; }
      fit();
    });
    $('prev').onclick = function(){ go(-1); };
    $('next').onclick = function(){ go(1); };
    $('clock').onclick = toggleClock; paintClock();
    document.addEventListener('keydown', function(e){
      var k = e.key;
      if (k === 'Escape'){ $('grid').classList.remove('on'); return; }
      if (k === 'ArrowRight' || k === 'PageDown' || k === ' '){ e.preventDefault(); go(1); }
      else if (k === 'ArrowLeft' || k === 'PageUp'){ e.preventDefault(); go(-1); }
      else if (k === 'ArrowDown'){ e.preventDefault(); revealAll(); }
      else if (k === 'Home'){ show(0, false); }
      else if (k === 'End'){ show(S.length - 1, true); }
      else if (k === 'o' || k === 'O'){ $('grid').classList.toggle('on'); }
      else if (k === 'n' || k === 'N'){ $('notes').classList.toggle('on'); }
      else if (k === 'p' || k === 'P'){ openPresenter(); }
      else if (k === 't' || k === 'T'){ toggleClock(); }
      else if (k === 'f' || k === 'F'){
        if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(function(){});
        else document.exitFullscreen().catch(function(){});
      }
    });
  }
})();
</script>
