(function(){
  var $ = function(id){ return document.getElementById(id); };
  var esc = function(s){ return String(s == null ? '' : s); };
  var S = DECK.slides || [], M = DECK.meta || {};
  var IDX = 0, STEP = 0, FLOW = false;

  document.title = (M.title || '簡報') + '｜' + (M.org || '');

  /* ── 判斷模式：窄螢幕 or 手機 → 瀑布流 ── */
  function isFlow(){
    var ua = navigator.userAgent;
    var mob = /Mobi|Android|iPhone|iPod/i.test(ua) ||
              (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    return mob || Math.min(innerWidth, innerHeight) < 620 || innerWidth < 860;
  }

  /* ── 產生每一頁 ── */
  function build(){
    $('deck').innerHTML = S.map(function(s, i){ return slideHtml(s, i); }).join('');
    $('tot').textContent = S.length;
  }

  function eyebrow(s){
    return s.eyebrow ? '<div class="eyebrow"><span class="bar"></span>' +
      '<span class="tx">' + esc(s.eyebrow) + '</span></div>' : '';
  }

  function slideHtml(s, i){
    var b = '', t = s.type;

    if (t === 'cover'){
      b = '<div class="cover-mark"></div><h1>' + esc(s.t) + '</h1>' +
        '<div class="cover-meta">' + (s.meta || []).map(function(m){
          return '<div>' + esc(m[0]) + '<b>' + esc(m[1]) + '</b></div>'; }).join('') + '</div>';
    }
    else if (t === 'section'){
      b = eyebrow(s) + '<div class="divider-wrap">' +
        '<div class="big-letter">' + esc(s.letter) + '</div>' +
        '<div class="divider-list">' + esc(s.list) + '</div></div>';
    }
    else if (t === 'stats'){
      b = eyebrow(s) + '<h2>' + esc(s.t) + '</h2>' +
        (s.sub ? '<div class="sub">' + esc(s.sub) + '</div>' : '') +
        '<div class="stats n' + (s.cols || (s.items || []).length) + '">' +
        (s.items || []).map(function(x){
          return '<div class="stat step' + (x.kind ? ' k-' + x.kind : '') + '">' +
            '<div class="n">' + (x.s ? '<small>' + esc(x.s) + '</small>' : '') + esc(x.n) + '</div>' +
            '<div class="k">' + esc(x.k) + '</div>' +
            '<div class="e">' + esc(x.e) + '</div></div>'; }).join('') + '</div>' +
        (s.band ? '<div class="band' + (s.bandKind ? ' ' + s.bandKind : '') + '">' + esc(s.band) + '</div>' : '');
    }
    else if (t === 'cards'){
      b = eyebrow(s) + '<h2>' + esc(s.t) + '</h2>' +
        (s.sub ? '<div class="sub">' + esc(s.sub) + '</div>' : '') +
        '<div class="cards n' + (s.cols || (s.items || []).length) + '">' +
        (s.items || []).map(function(x){
          return '<div class="card step"><h3><i></i>' + esc(x.h) + '</h3>' +
            esc(x.body || '') + '</div>'; }).join('') + '</div>' +
        (s.band ? '<div class="band' + (s.bandKind ? ' ' + s.bandKind : '') + '">' + esc(s.band) + '</div>' : '');
    }
    else if (t === 'items'){
      var its = s.items || [];
      b = eyebrow(s) + '<h2>' + esc(s.t) + '</h2>' +
        (s.lead ? '<div class="sub">' + esc(s.lead) + '</div>' : '') +
        '<div class="items' + (its.length > 6 ? ' two' : '') + '">' +
        its.map(function(x, k){
          var n = (k + 1) < 10 ? '0' + (k + 1) : (k + 1);
          return '<div class="item step"><div class="idx">' + n + '</div><div>' +
            '<h3>' + esc(x.h) + '</h3>' +
            (x.p ? '<p>' + esc(x.p) + '</p>' : '') + '</div></div>'; }).join('') + '</div>' +
        (s.band ? '<div class="band' + (s.bandKind ? ' ' + s.bandKind : '') + '">' + esc(s.band) + '</div>' : '');
    }
    else if (t === 'table'){
      var al = s.align || [];
      b = eyebrow(s) + '<h2>' + esc(s.t) + '</h2>' +
        (s.sub ? '<div class="sub">' + esc(s.sub) + '</div>' : '') +
        '<div class="tbl"><table><thead><tr>' +
        (s.head || []).map(function(h, k){
          return '<th class="' + (al[k] || '') + '">' + esc(h) + '</th>'; }).join('') +
        '</tr></thead><tbody>' +
        (s.rows || []).map(function(r){
          var cls = '';
          var cells = r.slice();
          if (cells[0] === '__tot'){ cls = 'tot'; cells[0] = '合計'; }
          else if (String(cells[0]).indexOf('__hi|') === 0){
            cls = 'hi'; cells[0] = String(cells[0]).slice(5); }
          else if (String(cells[0]).indexOf('__dim|') === 0){
            cls = 'dim'; cells[0] = String(cells[0]).slice(6); }
          return '<tr class="step ' + cls + '">' + cells.map(function(c, k){
            return '<td class="' + (al[k] || '') + '">' + esc(c) + '</td>'; }).join('') + '</tr>';
        }).join('') + '</tbody></table>' +
        (s.cap ? '<div class="cap">' + esc(s.cap) + '</div>' : '') + '</div>' +
        (s.band ? '<div class="band' + (s.bandKind ? ' ' + s.bandKind : '') + '">' + esc(s.band) + '</div>' : '');
    }
    else if (t === 'quote'){
      b = eyebrow(s) + '<h2>' + esc(s.t) + '</h2>' +
        (s.sub ? '<div class="sub">' + esc(s.sub) + '</div>' : '') +
        '<div class="cards n1" style="margin-top:26px"><div class="quote step">' +
        esc(s.quote) + '</div></div>' +
        (s.band ? '<div class="band step">' + esc(s.band) + '</div>' : '') +
        (s.after ? '<div class="band ok step">' + esc(s.after) + '</div>' : '');
    }
    else if (t === 'end'){
      b = eyebrow(s) +
        '<div style="flex:1;display:flex;flex-direction:column;justify-content:center">' +
        '<div class="end-big">' + esc(s.big) + '</div>' +
        '<div class="end-sub">' + esc(s.sub) + '</div></div>' +
        (s.foot ? '<div class="cover-meta"><div>REPORT<b>' + esc(s.foot) + '</b></div></div>' : '');
    }

    return '<section class="slide' + (s.dark ? ' dark' : '') + '" data-i="' + i + '">' + b + '</section>';
  }

  /* ── 播放控制（桌機） ── */
  function slides(){ return $('deck').querySelectorAll('.slide'); }
  function stepsOf(el){ return Array.prototype.slice.call(el.querySelectorAll('.step')); }

  function paint(el, k){
    stepsOf(el).forEach(function(x, i){ x.classList.toggle('shown', i < k); });
    var n = stepsOf(el).length;
    $('stepinfo').textContent = n ? ('· ' + k + '/' + n) : '';
  }

  function show(n, fill){
    if (n < 0) n = 0; if (n > S.length - 1) n = S.length - 1;
    IDX = n;
    var all = slides();
    for (var i = 0; i < all.length; i++) all[i].classList.remove('on', 'play');
    var el = all[IDX];
    el.classList.add('on');
    void el.offsetWidth;
    requestAnimationFrame(function(){ el.classList.add('play'); });
    $('cur').textContent = IDX + 1;
    $('prog').style.width = ((IDX + 1) / S.length * 100) + '%';
    $('notebody').textContent = (S[IDX] && S[IDX].note) || '（本頁無講稿）';
    STEP = fill ? stepsOf(el).length : 0;
    paint(el, STEP);
    Array.prototype.forEach.call($('gridwrap').children, function(c, k){
      c.classList.toggle('cur', k === IDX); });
  }

  function go(d){
    var el = slides()[IDX], n = stepsOf(el).length;
    if (d > 0){
      if (STEP < n){ STEP++; paint(el, STEP); return; }
      if (IDX < S.length - 1) show(IDX + 1, false);
    } else {
      if (STEP > 0){ STEP--; paint(el, STEP); return; }
      if (IDX > 0) show(IDX - 1, true);
    }
  }
  function revealAll(){ var el = slides()[IDX]; STEP = stepsOf(el).length; paint(el, STEP); }

  /* ── 總覽 ── */
  function buildGrid(){
    $('gridwrap').innerHTML = S.map(function(s, k){
      var t = s.t || s.big || (s.letter ? '分段 ' + s.letter : '封面');
      return '<div class="gcell" data-k="' + k + '"><div class="gn">' +
        String(k + 1).padStart(2, '0') + '</div><div class="gt">' +
        String(t).replace(/<br>/g, ' ') + '</div></div>'; }).join('');
    Array.prototype.forEach.call($('gridwrap').children, function(c){
      c.onclick = function(){ $('grid').classList.remove('on'); show(+c.dataset.k, true); };
    });
  }

  /* ── 縮放 ── */
  function fit(){
    if (FLOW) return;
    $('deck').style.transform = 'scale(' + Math.min(innerWidth / 1600, innerHeight / 900) + ')';
  }

  /* ── 計時 ── */
  var sec = 0, run = false, ct = null;
  function paintClock(){
    var m = Math.floor(sec / 60), s2 = sec % 60;
    $('clock').textContent = (m < 10 ? '0' : '') + m + ':' + (s2 < 10 ? '0' : '') + s2;
  }
  function toggleClock(){
    run = !run; $('clock').classList.toggle('run', run);
    if (run) ct = setInterval(function(){ sec++; paintClock(); }, 1000); else clearInterval(ct);
  }

  /* ── 簡報者視窗 ── */
  var PW = null;
  window.__deckState = function(){
    var s = S[IDX] || {}, nx = S[IDX + 1] || null;
    return { idx:IDX, total:S.length, step:STEP,
      title:String(s.t || s.big || '').replace(/<br>/g, ' '),
      lead:s.sub || s.lead || '',
      steps:(s.items || []).map(function(c){ return { h:c.h || c.k || '', p:c.p || c.e || '' }; }),
      note:s.note || '',
      next:nx ? String(nx.t || nx.big || '').replace(/<br>/g, ' ') : '（最後一頁）',
      org:M.org || '', date:M.date || '' };
  };
  window.__deckAll = function(){
    return S.map(function(s, i){
      return { no:i + 1, title:String(s.t || s.big || '').replace(/<br>/g, ' '),
        steps:(s.items || []).map(function(c){ return { h:c.h || c.k || '', p:c.p || c.e || '' }; }),
        note:s.note || '' };
    });
  };
  window.__deckGo = function(f){ (f === 'next' ? go(1) : go(-1)); };

  function openPresenter(){
    if (PW && !PW.closed){ PW.focus(); return; }
    PW = window.open('', 'wzPresenter', 'width=1060,height=760');
    if (!PW){ alert('瀏覽器擋掉了新視窗。\n請允許彈出式視窗後再按一次 P。'); return; }
    PW.document.open(); PW.document.write(presDoc()); PW.document.close();
  }

