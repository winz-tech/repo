      "function toggleT(){T0=T0?null:Date.now();tick()}function resetT(){T0=Date.now();tick()}" +
      "function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;')}" +
      "function draw(){if(!W||W.closed){document.getElementById('bd').innerHTML=" +
